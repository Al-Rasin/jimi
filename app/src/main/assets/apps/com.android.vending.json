  "deepLinks": [
    {
      "task": "search",
      "uri": "market://search?q={query}"
    },
    {
      "task": "app page",
      "uri": "market://details?id={query}"
    }
  ],
  "search": {
    "deepLink": "search"
  },
  "tasks": [
    {
      "name": "search apps",
      "say": [
        "search {query} on play store"
      ],
      "params": [
        "query"
      ],
      "steps": [
        {
          "do": "link",
          "target": "search",
          "expect": "search"
        }
      ]
    },
    {
      "name": "install an app",
      "say": [
        "install {query}"
      ],
      "params": [
        "query"
      ],
      "steps": [
        {
          "do": "link",
          "target": "search"
        },
        {
          "do": "tap",
          "target": "{first result}",
          "expect": "app"
        },
        {
          "do": "tap",
          "target": "Install"
        }
      ],
      "risky": true
    }
  ],
  "risky": [
    "Install",
    "Uninstall",
    "Buy",
    "Subscribe"
  ],
  "cannot": [
    {
      "what": "pay or buy",
      "why": "money needs you to confirm in the app"
    }
  ]
}
