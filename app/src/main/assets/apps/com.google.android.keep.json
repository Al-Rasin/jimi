  ],
  "search": {
    "screen": "notes",
    "selectors": [
      {
        "type": "hint",
        "value": "Search your notes"
      },
      {
        "type": "text",
        "value": "Search your notes"
      }
    ]
  },
  "tasks": [
    {
      "name": "write a note",
      "say": [
        "write a note {text}",
        "keep note {text}"
      ],
      "params": [
        "text"
      ],
      "steps": [
        {
          "do": "open",
          "expect": "notes"
        },
        {
          "do": "tap",
          "target": "New text note",
          "expect": "note"
        },
        {
          "do": "type",
          "target": "Note",
          "text": "{text}"
        },
        {
          "do": "back",
          "expect": "notes"
        }
      ]
    },
    {
      "name": "search notes",
      "say": [
        "find {query} in keep"
      ],
      "params": [
        "query"
      ],
      "steps": [
        {
          "do": "open",
          "expect": "notes"
        },
        {
          "do": "search",
          "text": "{query}"
        }
      ]
    }
  ],
  "risky": [
    "Delete",
    "Delete forever",
    "Empty trash"
  ],
  "cannot": []
}
