  "deepLinks": [
    {
      "task": "open user or channel",
      "uri": "tg://resolve?domain={user}"
    }
  ],
  "search": {
    "screen": "chats",
    "selectors": [
      {
        "type": "desc",
        "value": "Search"
      }
    ]
  },
  "tasks": [
    {
      "name": "open a channel",
      "say": [
        "open {user} on telegram"
      ],
      "params": [
        "user"
      ],
      "steps": [
        {
          "do": "link",
          "target": "open user or channel",
          "expect": "chat"
        }
      ]
    },
    {
      "name": "send a message",
      "say": [
        "send {text} to {contact} on telegram"
      ],
      "params": [
        "contact",
        "text"
      ],
      "steps": [
        {
          "do": "open",
          "expect": "chats"
        },
        {
          "do": "search",
          "text": "{contact}",
          "expect": "search"
        },
        {
          "do": "tap",
          "target": "{contact}",
          "expect": "chat"
        },
        {
          "do": "type",
          "target": "Message",
          "text": "{text}"
        },
        {
          "do": "tap",
          "target": "Send"
        }
      ],
      "risky": true
    }
  ],
  "risky": [
    "Send",
    "Delete",
    "Block",
    "Leave",
    "Call"
  ],
  "cannot": [
    {
      "what": "log in or sign up",
      "why": "needs your password or OTP"
    }
  ]
