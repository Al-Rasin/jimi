  "deepLinks": [
    {
      "task": "write email",
      "uri": "mailto:{contact}?subject={query}&body={text}",
      "action": "android.intent.action.SENDTO"
    }
  ],
  "search": {
    "screen": "inbox",
    "selectors": [
      {
        "type": "hint",
        "value": "Search in mail"
      },
      {
        "type": "text",
        "value": "Search in mail"
      }
    ]
  },
  "tasks": [
    {
      "name": "search mail",
      "say": [
        "search {query} in gmail"
      ],
      "params": [
        "query"
      ],
      "steps": [
        {
          "do": "open",
          "expect": "inbox"
        },
        {
          "do": "search",
          "text": "{query}"
        },
        {
          "do": "enter"
        }
      ]
    },
    {
      "name": "write an email",
      "say": [
        "email {contact} about {query}"
      ],
      "params": [
        "contact",
        "query",
        "text"
      ],
      "steps": [
        {
          "do": "link",
          "target": "write email",
          "expect": "compose"
        },
        {
          "do": "tap",
          "target": "Send"
        }
      ],
      "risky": true
    }
  ],
  "risky": [
