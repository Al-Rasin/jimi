  "tasks": [
    {
      "name": "send a message",
      "say": [
        "send {text} to {contact} on whatsapp",
        "whatsapp {contact} {text}"
      ],
      "params": [
        "contact",
        "text"
      ],
      "steps": [
        {
          "do": "open",
          "expect": "chats"
        },
        {
          "do": "search",
          "text": "{contact}",
          "expect": "search"
        },
        {
          "do": "tap",
          "target": "{contact}",
          "expect": "chat"
        },
        {
          "do": "type",
          "target": "Message",
          "text": "{text}"
        },
        {
          "do": "tap",
          "target": "Send",
          "expect": "chat"
        }
      ],
      "risky": true
    },
    {
      "name": "call someone",
      "say": [
        "whatsapp call {contact}"
      ],
      "params": [
        "contact"
      ],
      "steps": [
        {
          "do": "open",
          "expect": "chats"
        },
        {
          "do": "search",
          "text": "{contact}"
        },
        {
          "do": "tap",
          "target": "{contact}",
          "expect": "chat"
        },
        {
          "do": "tap",
          "target": "Voice call"
        }
      ],
      "risky": true
    },
    {
      "name": "open calls",
      "say": [
