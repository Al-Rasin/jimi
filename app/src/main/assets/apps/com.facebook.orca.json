  "tasks": [
    {
      "name": "send a message",
      "say": [
        "send {text} to {contact} on messenger"
      ],
      "params": [
        "contact",
        "text"
      ],
      "steps": [
        {
          "do": "open",
          "expect": "chats"
        },
        {
          "do": "search",
          "text": "{contact}",
          "expect": "search"
        },
        {
          "do": "tap",
          "target": "{contact}",
          "expect": "chat"
        },
        {
          "do": "type",
          "target": "Message",
          "text": "{text}"
        },
        {
          "do": "tap",
          "target": "Send"
        }
      ],
      "risky": true
    }
