<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application>
        <receiver android:name=".debug.SmokeCommandReceiver" android:exported="true">
            <intent-filter><action android:name="com.alrasin.jarvis.TEST_COMMAND" /></intent-filter>
        </receiver>
        <service android:name=".debug.SmokeCommandService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ADB debug smoke tests with bounded local model inference" />
        </service>
    </application>
</manifest>
